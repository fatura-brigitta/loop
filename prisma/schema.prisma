datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../app/prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Admin {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  password_hash String

  @@map("admins")
}

model Movie {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  director    String
  actors      String
  playtime    Int
  language    String
  trailer     String
  poster      String
  backdrop    String?
  onscreen    Boolean
  genre       String
  review      Float?
  description String?

  screenings Screening[]
  forum      Forum[]

  @@map("movies")
}

model Screening {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  hall_id           String   @db.ObjectId
  movie_id          String   @db.ObjectId
  start             DateTime
  end               DateTime
  screening_type_id String   @db.ObjectId

  payment_sessions Payment_session[]
  tickets          Ticket[]

  movies          Movie?          @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  halls           Hall?           @relation(fields: [hall_id], references: [id], onDelete: Cascade)
  screening_types Screening_type? @relation(fields: [screening_type_id], references: [id], onDelete: Cascade)

  @@map("screenings")
}

model User {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  email                String    @unique
  password_hash        String
  points               Int       @default(0)
  phone_number         String    @unique
  profile_image        String    @default("/profile/default.png")
  gender               String
  email_verified       Boolean   @default(false)
  email_code           String?
  email_code_exp       DateTime?
  password_reset_token String?
  password_reset_exp   DateTime?
  rank_id              String    @db.ObjectId

  ranks Rank? @relation(fields: [rank_id], references: [id], onDelete: Cascade)

  tickets          Ticket[]
  forum            Forum[]
  payment_sessions Payment_session[]
  coupons          Coupon[]
  forum_votes      ForumVote[]
  forum_replies    ForumReply[]

  @@map("users")
}

model Chair {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  row     Int
  column  Int
  hall_id String @db.ObjectId

  tickets Ticket[]

  halls Hall? @relation(fields: [hall_id], references: [id], onDelete: Cascade)

  @@map("chairs")
}

model Rank {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  point_limit Int
  image       String
  discount_id String? @db.ObjectId

  discount Discount? @relation(fields: [discount_id], references: [id], onDelete: Cascade)
  users    User[]

  @@map("ranks")
}

model Discount {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  image   String
  percent Int

  ranks   Rank[]
  coupons Coupon[]

  @@map("discounts")
}

model Hall {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  row    Int
  column Int

  screenings Screening[]
  chairs     Chair[]

  @@map("halls")
}

enum VoteType {
  LIKE
  DISLIKE
}

model ForumVote {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id  String   @db.ObjectId
  forum_id String   @db.ObjectId
  type     VoteType

  forum Forum? @relation(fields: [forum_id], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, forum_id])
  @@map("forum_votes")
}

model Forum {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  review   Float
  comment  String
  user_id  String @db.ObjectId
  movie_id String @db.ObjectId

  likes    Int @default(0)
  dislikes Int @default(0)

  votes   ForumVote[]
  replies ForumReply[]

  users  User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  movies Movie? @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("forums")
}

model ForumReply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  forum_id  String   @db.ObjectId
  user_id   String   @db.ObjectId
  comment   String
  createdAt DateTime @default(now())

  forum Forum? @relation(fields: [forum_id], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}

model Ticket {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  ticket_type_id    String    @db.ObjectId
  user_id           String    @db.ObjectId
  screening_type_id String    @db.ObjectId
  screening_id      String    @db.ObjectId
  chair_id          String    @db.ObjectId
  price             Int
  qr_token          String    @unique
  used_at           DateTime?

  ticket_types    Ticket_type?    @relation(fields: [ticket_type_id], references: [id], onDelete: Cascade)
  screening_types Screening_type? @relation(fields: [screening_type_id], references: [id], onDelete: Cascade)
  screenings      Screening?      @relation(fields: [screening_id], references: [id], onDelete: Cascade)
  users           User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chairs          Chair?          @relation(fields: [chair_id], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Ticket_type {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  type    String
  percent Int

  tickets          Ticket[]
  payment_sessions Payment_session[]

  @@map("ticket_types")
}

model Screening_type {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  type    String
  percent Int

  tickets    Ticket[]
  screenings Screening[]

  @@map("screening_types")
}

model Payment_session {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String   @db.ObjectId
  screening_id   String   @db.ObjectId
  chair_ids      Json
  status         String
  createdAt      DateTime @default(now())
  ticket_type_id String?  @db.ObjectId

  ticket_types Ticket_type? @relation(fields: [ticket_type_id], references: [id])
  users        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  screenings   Screening    @relation(fields: [screening_id], references: [id], onDelete: Cascade)

  @@map("payment_sessions")
}

model Coupon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id     String   @db.ObjectId
  discount_id String   @db.ObjectId
  qr_token    String   @unique
  used        Boolean  @default(false)
  created_at  DateTime @default(now())

  users     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  discounts Discount @relation(fields: [discount_id], references: [id], onDelete: Cascade)

  @@map("coupons")
}
